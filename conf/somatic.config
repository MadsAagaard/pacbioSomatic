/*
 * =============================================================================
 * pacbioSomatic/conf/somatic.config — pipeline config (between lrsShared.config and finalize.config)
 * Somatic DNA (T/N) + RNA (Kinnex) params, output layout and overrides.
 * Shared values come from lrsShared.config.
 * =============================================================================
 * Carved out of nextflowLRS_somaticDNA_RNA_v1.config. Every key is renamed to
 * lowerCamelCase; the old -> new map is tools/params_rename.tsv, and
 * tools/rename_params.py applies it to modules/*.nf and main.nf in one pass.
 * Values are unchanged except where marked CHANGED.
 *
 * Keys removed because no .nf file reads them (listed in the plan):
 *   assembly, gencode_gff3, kinnex_mas8_adapters, expr_method, expr_genelist,
 *   splicing_genelist, splicing_bsgenome, splicing_ptcDist, splicing_noNMD
 * =============================================================================
 */


// =============================================================================
// 1. SOMATIC CLI FLAGS
// =============================================================================
params {
    // ---- arm control ------------------------------------------------------------
    skipRNA         = false     // disable the entire RNA arm
    skipQC          = false
    skipVariants    = false
    skipSV          = false
    somaticRNA      = false     // RNA somatic analysis (fusion, ASE, expression outlier, splicing)
    spliceRNA       = true      // entry-point switch (NOT USED YET)

    // ---- read set ----------------------------------------------------------------
    allReads        = false
    failedReads     = false
    minGB           = 36        // NB: no .nf file reads minGB today (size gate not applied)

    // ---- input -------------------------------------------------------------------
    inputDNA        = null      // folder of DNA uBAMs (overrides dataArchive glob)
    inputRNA        = null      // folder of demultiplexed RNA uBAMs (overrides dataArchiveRNA glob)

    dataArchive     = "${params.dataArchiveRoot}/rawData"          // was dataArchiveDNA (no trailing '/', as before)
    dataArchiveRNA  = "${params.dataArchiveRoot}/rawData/2026"

    // ---- containers ------------------------------------------------------------
    deepvariantDefault = 'latest'   // deepvariant/deepsomatic 1.10.0, as before

    // ---- error handling ----------------------------------------------------------
    // CHANGED: was errorStrategy = 'ignore' for every task. 'cohort' is the
    // closest supported mode (transient failures retried twice, then ignored)
    // and needs the FAILED_TASKS manifest in main.nf workflow.onComplete.
    errorMode       = 'cohort'
}


// =============================================================================
// 2. DERIVED RUN CONTEXT + OUTPUT
// =============================================================================
params.readSet = params.hifiReads ? 'hifi' : params.allReads ? 'allReads' : 'hifi'
if (params.hifiReads) { params.minGB = 30 }

params.outputDirBase = params.outdir
    ? "${params.outdir}"
    : "/lnx01_data3/pacBioAnalyzedSamplesSomatic/${params.genome}/${params.yearStamp}/"

params.lrsStorage = "${params.lrsStorageRoot}/${params.genome}/somatic/"     // was lrsStorageBase

// Somatic publishes relative to the launch dir ("${meta.id}/..."). outBase
// returns exactly that, so a shared module publishing to ${params.outBase(meta)}/x
// lands where the somatic module did. Output tree unchanged.
params.outBase    = { meta -> "${meta.id}" }
params.multiqcKey = { meta -> meta.id }

params.tumorboardAlignSubdir = 'TUMORBOARDFILES/varSeqImport/alignments'

// The 731-sample DB (germline uses the 184-sample DB from lrsShared.config, section 5).
params.sawfishSvdb = "${params.refFilesDir}/hg38/pacbio_hg38/inhouseDBs/260728.731samples.sawfish.svdb.db"


// =============================================================================
// 3. SCRIPTS AND PROGRAMS
// =============================================================================
def somScripts = "${params.helperScripts}/somatic"

params {
    somaticScripts         = somScripts
    owlBin                 = "${params.programPath}/owl_04/owl"
    isocallBin             = "${params.programPath}/BIN/isocall-v1.0"

    // lrsCustomTools release (pinned at launch through lrsCustomToolsBase)
    somaticDnaSummaryPy    = "${params.lrsCustomToolsBase}/summaryScripts/somaticDNA/somatic_dna_summary.py"
    somaticDnaSummaryHtml  = "${params.lrsCustomToolsBase}/summaryScripts/somaticDNA/somatic_dna_summary_report_template.html"
    somaticRnaSummaryPy    = "${params.lrsCustomToolsBase}/summaryScripts/somaticRNA/somatic_rna_summary.py"
    somaticRnaSummaryHtml  = "${params.lrsCustomToolsBase}/summaryScripts/somaticRNA/somatic_rna_summary_report_template.html"
    lrsSplicePy            = "${params.lrsCustomToolsBase}/splicing/lrs_splice.py"
    lrsSpliceReportPy      = "${params.lrsCustomToolsBase}/splicing/reporting/lrs_splice_report.py"
    fusionAnnotatePy       = "${params.lrsCustomToolsBase}/fusion/fusion_annotate.py"
    fusionAnnotation       = "${params.lrsCustomToolsBase}/resources/gencode.v49.mane_select.v261008.genePred"
    fusionDomains          = "${params.lrsCustomToolsBase}/resources/assets_v261008/uniprot_domains.v261008.mane.tsv"
    fusionGeneList         = "${params.lrsCustomToolsBase}/resources/tumorboard.MOMA.FusionList.v2.237genes.current.txt"

    // helper scripts (not yet in lrsCustomTools)
    scarhrdR               = "${somScripts}/scarhrd_hrd_v3.R"
    wakhanScarhrdBedPy     = "${somScripts}/wakhan_cna_to_scarhrd_v2.py"
    wakhanScarhrdPy        = null      // v1, commented out in the old config; process scarhrd_wakhan is not called
    expressionOutlierR     = "${somScripts}/expression_outlier.R"
    isoformSwitchR         = "${somScripts}/isoformSwitch_singleSample.R"
    methylExprPy           = "${somScripts}/methyl_expr_integrate_v1.py"
    fusionSvPy             = "${somScripts}/fusion_sv_concordance_v1.py"

    // gene lists
    inhouseFusionGenelist   = "${params.refFilesDirLegacy}/databases/genelists/tumortarget/250711.inhouse.MOMA.FusionList.for.grep.LRS_reducedHeader.txt"
    inhouseSplicingGenelist = "${params.refFilesDirLegacy}/databases/genelists/tumortarget/tumortarget.inhouse.v2.131genes.clean.txt"

    // Kinnex barcodes (not genome-dependent)
    kinnexBarcodes12plex   = "${params.refFilesDir}/hg38/pacbio_hg38/rnaseq_resources/primers_and_barcode_fasta/12plex.barcodes.fasta"
}


// =============================================================================
// 4. TOOL PARAMETERS
// =============================================================================
params {
    // ---- lrs_splice ----------------------------------------------------------
    spliceMinReads         = 3
    spliceMinUsage         = 0.02
    spliceMinAnchor        = 15
    spliceMinDepth         = 10
    spliceMaxFDR           = 0.10
    spliceIrMinFrac        = 0.10
    spliceVariantWindow    = 50
    spliceHighMinReads     = 10
    spliceTandemMaxShift   = 4
    spliceAnnotatedCap     = 'any'
    spliceRecurrenceMode   = 'flag'    // flag | filter
    spliceRecurrenceExempt = null      // TSV of known pathogenic junctions
    spliceGeneAliases      = null      // was splicing_genelist_aliases (read by lrs_splice, never defined)

    // ---- IsoformSwitchAnalyzeR -----------------------------------------------
    isoformSwitchMinIF     = 0.05

    // ---- fusion annotation (TEST PHASE) --------------------------------------
    fusionMinConfidence    = 'MEDIUM'
    skipFusionAnnotate     = false

    // ---- wakhan / scarHRD ----------------------------------------------------
    wakhanPurityRange           = '0.15-1'
    wakhanPloidyRange           = '1.1-7'
    scarhrdWakhanMinCNQ         = 0.7
    scarhrdWakhanBedMinCNQ      = 0
    scarhrdWakhanBedMinCovFrac  = 0.25
    scarhrdWakhanBedMinSegLen   = 1000000
    scarhrdWakhanBedExcludeBeds = [ params.sawfishExcludeRegions, params.wakhanCentromereBed ]

    // ---- ASE -------------------------------------------------------------------
    aseMinMapQ             = 20
    aseMinBaseQ            = 10

    // ---- expression outlier ----------------------------------------------------
    exprBackground         = "${params.lrsStorage}/RNA/expressionCohort/background.geneCounts.tsv"
    exprCohortDir          = "${params.lrsStorage}/RNA/expressionCohort"
    exprMinCohort          = 30

    // ---- methylation x expression integration ---------------------------------
    promoterUp             = 1500
    promoterDown           = 500
    methCol                = 3       // 0-based: methylation % column
    methCovCol             = 5       // 0-based: coverage column (-1 to disable weighting)
    methMinCov             = 4
    methHyper              = 60
    methDelta              = 20
    methylExprGenelist     = params.inhouseSplicingGenelist
    fusionSvWindow         = 10000
}


// =============================================================================
// 5. SOMATIC-ONLY CONDA ENVS (merged into params.condaEnvs from lrsShared.config)
// =============================================================================
params {
    condaEnvs {
        // Overrides base: somatic has always used pbmm2_latest, while base
        // switches on --latestVersions. Kept as before; see plan, Decisions.
        pbmm2        = "${params.condaLocal}/pbmm2_latest/"

        severus      = "${params.condaLocal}/severus/"
        hmftools     = "${params.condaLocal}/hmftools/"
        purple       = "${params.condaLocal}/circos_purple/"
        chord        = "${params.condaLocal}/chord/"
        sigrap02     = "${params.condaLocal}/sigrap02/"
        scarhrd      = "${params.condaLocal}/scarHRD/"
        wakhan       = "${params.condaLocal}/wakhan/"
        pcgr212      = "${params.condaLocal}/pcgr212"
        pcgrr212     = "${params.condaLocal}/pcgrr212"
        integration  = "${params.condaLocal}/somaticSummaryEnv/"   // was integrationEnv
        // RNA
        skera        = "${params.condaLocal}/pbskera/"
        lima         = "${params.condaLocal}/lima/"
        isoseqPbtk   = "${params.condaLocal}/isoseq_pbtk/"
        isoseq       = "${params.condaLocal}/isoseq/"
        pbfusion     = "${params.condaLocal}/pbfusion/"
        pigeon       = "${params.condaLocal}/pigeon262/"
        sqanti3      = "${params.condaLocal}/sqanti3/"
        aseGatk      = "${params.condaLocal}/gatk4620/"
        rnaIso       = "${params.condaLocal}/rnaISO/"
        rnaOutrider  = "${params.condaLocal}/rnaOUTRIDER/"
        oarfish      = "${params.condaLocal}/oarfish/"
    }
}

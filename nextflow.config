/*
 Top-level config (v2): genome switch -> versioned shared config.
 Run with:  nextflow -C nextflow_v2.config run main_v2.nf --samplesheet <sheet.tsv>
 (-C uses ONLY this config, ignoring any nextflow.config in the launch dir.)
*/
params {
    genome = 'hg38'
    rundir = "${launchDir.baseName}"
}
switch (params.genome) {
    case 'hg38':
        includeConfig '/data/configs/lrs_somatic_rna_v2.config'
        break
    case 't2t':
        def c = new File('/data/configs/lrs_somatic_rna_T2T.config')
        if (c.exists()) { includeConfig c }
        break
}
